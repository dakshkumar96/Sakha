# Copy to .env and fill values. Never commit real keys.

# --- Gemini (LLM) ---
GEMINI_API_KEY=
# Optional; default is gemini-2.0-flash
GEMINI_MODEL=gemini-flash-lite-latest
# Tried in order when primary hits 429 (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.0-flash-lite,gemini-flash-latest,gemini-2.0-flash

# --- Supabase ---
# Prefer Project Settings → API Keys.
# New UI: sb_publishable_... → ANON; sb_secret_... → SERVICE_ROLE
# Legacy JWT: eyJ... anon / service_role still work the same way.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Kokoro-FastAPI TTS ---
# https://github.com/remsky/Kokoro-FastAPI
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_API_KEY=not-needed
KOKORO_VOICE_EN=am_michael
KOKORO_VOICE_HI=hf_alpha
KOKORO_SPEED=0.9

# --- App ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
