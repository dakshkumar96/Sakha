# Copy to .env on the VM (next to docker-compose.yml) and fill in real values.
# Never commit the real .env.

GEMINI_API_KEY=
# Comma-separated, no trailing slash — set to your Vercel URL(s).
CORS_ORIGINS=https://sakha1.vercel.app
# The DuckDNS (or any) subdomain you pointed at this VM's public IP.
DOMAIN=sakha-backend.duckdns.org
