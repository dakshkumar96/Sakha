# Copy to .env on the VM (next to docker-compose.yml) and fill in real values.
# Never commit the real .env. Every line here reaches the backend container.

GEMINI_API_KEY=
# Comma-separated, no trailing slash. Set to your Vercel URL(s).
CORS_ORIGINS=https://sakha-hazel.vercel.app
# The DuckDNS (or any) subdomain you pointed at this VM's public IP.
DOMAIN=sakha-backend.duckdns.org

# Optional tuning. Unset uses the default in backend/config.py.
# Most model calls the whole site makes in one UTC day.
# GEMINI_DAILY_CALL_CAP=400
# Chats and voice calls per visitor per minute.
# CHAT_RATE_PER_MINUTE=10
# TTS_RATE_PER_MINUTE=20
